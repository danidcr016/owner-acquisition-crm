# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Passwords for the default accounts (admin, developer, agent).
# Leave unset and the app will generate a one-time password and
# print it to the console on first run.
ADMIN_PASSWORD=
DEVELOPER_PASSWORD=
AGENT_PASSWORD=

# Optional. Defaults to local SQLite if unset.
# Example for Postgres: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Optional. Never set to true in production.
FLASK_DEBUG=false
